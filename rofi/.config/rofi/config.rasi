/* --- TEMA VISUAL: NARANJA WOFI STYLE --- */
* {
    /* Paleta Naranja y Fondo Oscuro con Transparencia para Hyprglass */
    background:     #11111bA0;  /* Fondo con transparencia (aprox 62%) */
    background-alt: #1e1e2eA0;  /* Fondo items con transparencia */
    foreground:     #cdd6f4;  /* Texto blanco suave */
    
    /* EL PROTAGONISTA: NARANJA */
    selected:       #fab387;  /* Naranja pastel (Peach) */
    selected-fg:    #11111b;  /* Texto negro sobre naranja */
    active:         #f9e2af;  /* Amarillo para items activos */
    urgent:         #f38ba8;
    
    border-color:   #fab387;  /* Borde naranja */
}

configuration {
    /* Mantenemos tu fuente y configuración base */
    modi: "drun,run,window,power:/home/stefano/.config/rofi/power_menu.sh,pres:/home/stefano/.config/rofi/presentation-menu.sh";
    show-icons: true;
    drun-show-actions: true;
    //kb-custom-1: "Alt+a";
    font: "JetBrainsMono Nerd Font 12";

    /* Etiqueta que se verá en la barra de Rofi para tu nuevo menú */
    display-test: "🛠️ Test";
    display-drun: "🔎 Apps";
    display-power: "⏻ Sistema";
    display-pres: " Presentación";

    //run-shell-command: "{terminal} -e {cmd}";
}

window {
    transparency: "real";
    width: 40%;
    height: 60%;
    
    /* Soft glowing border (Peach colored with opacity) */
    border: 1px;
    border-radius: 16px;
    border-color: #fab38760;
    background-color: @background;
    padding: 18px;
}

mainbox {
    background-color: transparent;
    children: [inputbar, listview];
}

/* --- LISTA Y ELEMENTOS --- */
listview {
    background-color: transparent;
    border: 0px;
    spacing: 6px;
    scrollbar: false;
    margin: 10px 0px 0px 0px;
}

element {
    padding: 10px 12px;
    background-color: transparent;
    text-color: @foreground;
    border-radius: 8px;
    border: 1px;
    border-color: transparent; /* Evita que el texto tiemble al seleccionarse */
}

/* Normal States */
element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element normal.urgent {
    background-color: @urgent;
    text-color: @foreground;
}

element normal.active {
    background-color: @active;
    text-color: @foreground;
}

/* Selected States (Soft Peach Glass Pill) */
element selected.normal {
    background-color: #fab38722; /* Fondo naranja muy traslúcido */
    border-color: @selected;      /* Borde naranja brillante */
    text-color: #ffffff;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @foreground;
}

element selected.active {
    background-color: @active;
    text-color: @foreground;
}

/* Alternate States (All transparent to avoid dark blocks) */
element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.urgent {
    background-color: @urgent;
    text-color: @foreground;
}

element alternate.active {
    background-color: @active;
    text-color: @foreground;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    background-color: transparent;
}

element-icon {
    size: 24px;
    margin: 0px 12px 0px 0px;
    background-color: transparent;
    text-color: inherit;
}

/* --- BARRA DE BÚSQUEDA ESTILO SPOTLIGHT --- */
inputbar {
    children: [prompt, entry];
    background-color: #1e1e2e50; /* Caja de búsqueda integrada y translúcida */
    border: 1px;
    border-color: #ffffff10;
    border-radius: 8px;
    padding: 10px 14px;
    margin: 0px 0px 8px 0px;
}

prompt {
    background-color: transparent;
    text-color: @selected;
    padding: 0px;
    margin: 0px 12px 0px 0px;
    vertical-align: 0.5;
}

entry {
    background-color: transparent;
    text-color: @foreground;
    padding: 0px;
    vertical-align: 0.5;
}
