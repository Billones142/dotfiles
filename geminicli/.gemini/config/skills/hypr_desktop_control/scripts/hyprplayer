#!/bin/bash
# hyprplayer - media control wrapper for Hyprland session
# Usage:
#   hyprplayer list
#   hyprplayer pause-video
#   hyprplayer pause-all
#   hyprplayer pause-player <player>

CMD="$1"
PLAYER="$2"

if ! command -v playerctl &> /dev/null; then
    echo "Error: playerctl is not installed." >&2
    exit 1
fi

case "$CMD" in
    list)
        playerctl -l
        echo "---"
        playerctl --all-players metadata
        ;;
    pause-video)
        # Find active video/browser players to pause (brave, chromium, plasma-browser-integration, firefox)
        PLAYERS=$(playerctl -l 2>/dev/null)
        PAUSED_ANY=false
        for p in $PLAYERS; do
            if [[ "$p" =~ (brave|chromium|plasma-browser-integration|firefox) ]]; then
                playerctl -p "$p" pause 2>/dev/null
                echo "Paused video player: $p"
                PAUSED_ANY=true
            fi
        done
        if [ "$PAUSED_ANY" = false ]; then
            echo "No active video players found to pause."
        fi
        ;;
    pause-all)
        playerctl pause
        echo "Paused all media players."
        ;;
    pause-player)
        if [ -z "$PLAYER" ]; then
            echo "Usage: hyprplayer pause-player <player>" >&2
            exit 1
        fi
        playerctl -p "$PLAYER" pause
        echo "Paused player: $PLAYER"
        ;;
    *)
        echo "Usage: hyprplayer {list|pause-video|pause-all|pause-player <player>}" >&2
        exit 1
        ;;
esac
