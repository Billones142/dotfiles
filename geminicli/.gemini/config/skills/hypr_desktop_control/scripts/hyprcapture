#!/bin/bash
# hyprcapture - take non-interactive screenshots in Hyprland
# Usage:
#   [HYPRCAPTURE_DIR=/path/to/dir] hyprcapture [window|output] [target]

MODE=${1:-output}
TARGET="$2"
OUTPUT_DIR="${HYPRCAPTURE_DIR:-${HOME}/.gemini/antigravity-cli/scratch}"
FILENAME="hypr_capture.png"
OUTPUT_PATH="${OUTPUT_DIR}/${FILENAME}"

# Ensure output directory exists
mkdir -p "$OUTPUT_DIR"

# Ensure grim is available
if ! command -v grim &> /dev/null; then
    echo "Error: grim is not installed." >&2
    exit 1
fi

if [ -n "$TARGET" ]; then
    # Parse target (e.g. class:Brave-origin or address:0x...)
    TYPE=$(echo "$TARGET" | cut -d':' -f1)
    VAL=$(echo "$TARGET" | cut -d':' -f2-)
    
    if [ "$TYPE" = "address" ] || [ "$TYPE" = "class" ] || [ "$TYPE" = "title" ]; then
        GEOMETRY=$(hyprctl clients -j | jq -r ".[] | select(.${TYPE} == \"${VAL}\") | \"\\(.at[0]),\\(.at[1]) \\(.size[0])x\\(.size[1])\"" | head -n 1)
    else
        # Default to class if no prefix
        GEOMETRY=$(hyprctl clients -j | jq -r ".[] | select(.class == \"${TARGET}\") | \"\\(.at[0]),\\(.at[1]) \\(.size[0])x\\(.size[1])\"" | head -n 1)
    fi
    
    if [ -z "$GEOMETRY" ] || [ "$GEOMETRY" = "null" ] || [ "$GEOMETRY" = " " ]; then
        echo "Error: Target window '$TARGET' not found or has no geometry." >&2
        
        if command -v notify-send &> /dev/null; then
            notify-send -a "hyprcapture" -u critical "Captura Fallida" "No se encontró la ventana '$TARGET'."
        fi
        exit 1
    fi
    
    grim -g "$GEOMETRY" "$OUTPUT_PATH"
else
    # Default behavior (active window or output)
    if [ "$MODE" = "window" ]; then
        if ! command -v hyprshot &> /dev/null; then
            echo "Error: hyprshot is not installed." >&2
            exit 1
        fi
        hyprshot -m window -m active -o "$OUTPUT_DIR" -f "$FILENAME" --silent >/dev/null 2>&1
    else
        if command -v hyprshot &> /dev/null; then
            hyprshot -m output -m active -o "$OUTPUT_DIR" -f "$FILENAME" --silent >/dev/null 2>&1
        else
            grim "$OUTPUT_PATH"
        fi
    fi
fi

if [ -f "$OUTPUT_PATH" ]; then
    echo "Screenshot captured successfully: $OUTPUT_PATH"
    echo "IMAGE_PATH=$OUTPUT_PATH"
    
    # Send desktop notification
    if command -v notify-send &> /dev/null; then
        if [ -n "$TARGET" ]; then
            notify-send -a "hyprcapture" -i camera-photo "Captura de Pantalla" "Se guardó captura de la ventana '$TARGET' sin cambiar el foco."
        else
            notify-send -a "hyprcapture" -i camera-photo "Captura de Pantalla" "Se guardó captura de tipo '$MODE' en: $OUTPUT_PATH"
        fi
    fi
else
    echo "Error: Failed to take screenshot." >&2
    
    # Send failure desktop notification
    if command -v notify-send &> /dev/null; then
        notify-send -a "hyprcapture" -u critical "Captura Fallida" "Error al intentar guardar captura."
    fi
    exit 1
fi
