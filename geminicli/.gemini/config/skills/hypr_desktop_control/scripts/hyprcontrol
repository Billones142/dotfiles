#!/bin/bash
# hyprcontrol - run hyprctl dispatches and send desktop notifications
# Usage:
#   hyprcontrol '<lua-dispatcher>'

DISPATCHER="$1"

if [ -z "$DISPATCHER" ]; then
    echo "Usage: hyprcontrol '<lua-dispatcher>'" >&2
    exit 1
fi

# Execute the dispatch command
RESULT=$(hyprctl dispatch "$DISPATCHER" 2>&1)
EXIT_CODE=$?

if [ $EXIT_CODE -eq 0 ] && [ "$RESULT" = "ok" ]; then
    echo "Success: $RESULT"
    
    # Extract friendly description for notification if possible
    TITLE="Control de Hyprland"
    MSG="Se ejecutó con éxito: $DISPATCHER"
    
    # Define patterns in variables to avoid bash regex parsing issues
    pat_window='hl\.dsp\.focus.*window\ *=\ *"([^"]+)"'
    pat_dir='hl\.dsp\.focus.*direction\ *=\ *"([^"]+)"'
    pat_special='hl\.dsp\.workspace\.toggle_special\("([^"]+)"\)'
    pat_workspace='hl\.dsp\.focus.*workspace\ *=\ *"([^"]+)"'
    pat_float='hl\.dsp\.window\.float'

    if [[ "$DISPATCHER" =~ $pat_window ]]; then
        TITLE="Foco Cambiado"
        MSG="Ventana enfocada: ${BASH_REMATCH[1]}"
    elif [[ "$DISPATCHER" =~ $pat_dir ]]; then
        TITLE="Foco Cambiado"
        DIR="${BASH_REMATCH[1]}"
        case "$DIR" in
            l) DIR_NAME="izquierda" ;;
            r) DIR_NAME="derecha" ;;
            u) DIR_NAME="arriba" ;;
            d) DIR_NAME="abajo" ;;
            *) DIR_NAME="$DIR" ;;
        esac
        MSG="Foco movido hacia la $DIR_NAME"
    elif [[ "$DISPATCHER" =~ $pat_special ]]; then
        TITLE="Workspace Especial"
        MSG="Workspace especial alternado: ${BASH_REMATCH[1]}"
    elif [[ "$DISPATCHER" =~ $pat_workspace ]]; then
        TITLE="Workspace Cambiado"
        MSG="Workspace enfocado: ${BASH_REMATCH[1]}"
    elif [[ "$DISPATCHER" =~ $pat_float ]]; then
        TITLE="Estado de Ventana"
        MSG="Estado flotante de la ventana alternado"
    fi
    
    if command -v notify-send &> /dev/null; then
        notify-send -a "hyprcontrol" -i preferences-desktop-display "$TITLE" "$MSG"
    fi
else
    echo "Error executing dispatcher: $RESULT" >&2
    if command -v notify-send &> /dev/null; then
        notify-send -a "hyprcontrol" -u critical "Error de Control" "Fallo al ejecutar: $DISPATCHER\nError: $RESULT"
    fi
    exit 1
fi
